# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
.env
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Project generated data ────────────────────────────────────────────────────
# Corpus JSONL files and activation .npy files are released publicly on
# HuggingFace Hub (ayushi-agarwall/poolbench) — not stored in this git repo.
# Download them with:
#   huggingface-cli download ayushi-agarwall/poolbench --repo-type dataset --local-dir .
data/corpora/*/
!data/corpora/.gitkeep

# Raw HF download cache (large)
data/raw/
!data/raw/.gitkeep

# Activation .npy files (very large — released on HF Hub)
results/activations/
results/bert_classifiers/
results/*.log
!results/.gitkeep

# ── Notebooks / IDE ───────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb
.idea/
.vscode/
*.DS_Store

# ── HuggingFace cache ─────────────────────────────────────────────────────────
~/.cache/huggingface/

# ── SAE checkpoints ───────────────────────────────────────────────────────────
*.safetensors
*.bin
*.pt
*.pth
